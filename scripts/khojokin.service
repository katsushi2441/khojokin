[Unit]
Description=Kurage hojokin navi (khojokin) :18360
After=network-online.target

[Service]
WorkingDirectory=/home/kojima/work/khojokin
EnvironmentFile=-/home/kojima/work/khojokin/.env
Environment=KHOJO_PUBLIC_BASE=https://kurage.exbridge.jp/khojokin.php/
ExecStart=/home/kojima/work/khojokin/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 18360 --proxy-headers --forwarded-allow-ips=*
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
